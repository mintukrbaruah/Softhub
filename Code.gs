const FOLDER_ID = "1Ors4wVon1u24w-CvF3XYNEgy2SAIWayf";
const ADMIN_TOKEN = "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET";
function doGet() { const folder=DriveApp.getFolderById(FOLDER_ID); const files=folder.getFiles(); const categories=PropertiesService.getScriptProperties(); const result=[]; while(files.hasNext()){const file=files.next(); result.push({id:file.getId(),name:file.getName(),size:file.getSize(),category:categories.getProperty("category_"+file.getId())||"Uncategorized",downloadUrl:"https://drive.google.com/uc?export=download&id="+file.getId()});} return json({files:result}); }
function doPost(e) { try { const body=JSON.parse(e.postData.contents||"{}"); if(body.token!==ADMIN_TOKEN) return json({error:"Unauthorized"}); if(body.action!=="upload") return json({error:"Unknown action"}); const folder=DriveApp.getFolderById(FOLDER_ID); const blob=Utilities.newBlob(Utilities.base64Decode(body.data),body.mimeType||"application/octet-stream",body.name); const file=folder.createFile(blob); PropertiesService.getScriptProperties().setProperty("category_"+file.getId(), body.category||"Uncategorized"); return json({ok:true,id:file.getId(),name:file.getName()}); } catch(error) { return json({error:error.message}); } }
function json(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON)}